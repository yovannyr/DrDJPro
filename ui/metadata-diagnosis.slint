import { TextEdit } from "std-widgets.slint";
import { LibraryButton } from "controls.slint";

export struct MetadataDiagnosisView { open: bool, track-id: int, text: string, compare: bool }

export component MetadataDiagnosisPanel inherits Rectangle {
    in property <MetadataDiagnosisView> diagnosis;
    out property <bool> text-focused: self.visible && content.has-focus;
    callback close();
    callback compare-tempo();
    changed visible => {
        if self.visible { content.content-y = 0px; content.focus(); }
    }
    accessible-role: groupbox; accessible-label: "BPM and key sources";
    background: #171a1f;
    VerticalLayout {
        padding: 2px; spacing: 2px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: "BPM and key sources"; font-size: 12px; font-weight: 600;
                color: #f4f4f5; vertical-alignment: center; horizontal-stretch: 1;
            }
            if root.diagnosis.compare : LibraryButton {
                text: "Compare BPM"; accessible-label: "Hear tempo interpretations from diagnosis";
                clicked => { root.compare-tempo(); }
            }
            LibraryButton { text: "Close"; accessible-label: "Close metadata diagnosis"; clicked => { root.close(); } }
        }
        content := TextEdit {
            text: root.diagnosis.text; read-only: true; wrap: word-wrap; font-size: 12px;
            min-height: 28px; vertical-stretch: 1;
            accessible-label: "Tag, analysis and catalog values";
            accessible-action-set-value(value) => { }
        }
    }
}
