import { ModernTheme } from "modern-theme.slint";

// Edge-aware control: never turn a cue press into an ordinary clicked callback.
export component HoldButton inherits Rectangle {
    in property <string> text;
    in property <string> accessibility-label: root.text;
    in property <bool> enabled: false;
    in property <bool> active: false;
    in property <color> accent: ModernTheme.green;
    callback started();
    callback ended();
    callback canceled();
    property <bool> engaged: false;
    min-width: 24px;
    preferred-width: 56px;
    height: 28px;
    border-radius: 2px;
    border-width: 1px;
    border-color: key.has-focus ? #efffff : ModernTheme.line;
    background: root.engaged ? root.accent : (root.active ? #244235 : ModernTheme.raised);
    forward-focus: key;
    accessible-role: button;
    accessible-label: root.accessibility-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.started(); root.ended(); } }
    changed enabled => {
        if !root.enabled && root.engaged {
            root.engaged = false;
            root.canceled();
        }
    }
    Text {
        text: root.text; color: root.enabled ? ModernTheme.text : ModernTheme.muted;
        font-size: 11px; horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                if root.engaged { root.engaged = false; root.canceled(); }
            } else if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    key.focus();
                    if !root.engaged { root.engaged = true; root.started(); }
                } else if event.kind == PointerEventKind.up {
                    if root.engaged { root.engaged = false; root.ended(); }
                }
            }
        }
    }
    key := FocusScope {
        width: 0px; height: 0px;
        enabled: root.enabled;
        focus-lost(reason) => {
            if root.engaged { root.engaged = false; root.canceled(); }
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if !event.repeat && !root.engaged { root.engaged = true; root.started(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                if root.engaged { root.engaged = false; root.ended(); }
                return accept;
            }
            return reject;
        }
    }
}

// value is controller-owned; a drag proposes a new value instead of changing audio state.
export component ValueRail inherits Rectangle {
    in property <float> value: 0.5;
    in property <bool> vertical: true;
    in property <bool> enabled: false;
    in property <color> accent: ModernTheme.text;
    in property <string> label;
    callback requested(float);
    callback gesture-ended();
    background: #080a0d;
    border-width: 1px; border-color: ModernTheme.line;
    min-width: 14px; min-height: 14px;
    property <bool> dragging: false;
    Rectangle {
        x: root.vertical ? (parent.width - 2px) / 2 : 4px;
        y: root.vertical ? 4px : (parent.height - 2px) / 2;
        width: root.vertical ? 2px : parent.width - 8px;
        height: root.vertical ? parent.height - 8px : 2px;
        background: ModernTheme.line;
    }
    Rectangle {
        x: root.vertical ? 2px : 4px + clamp(root.value, 0, 1) * max(0px, parent.width - 18px);
        y: root.vertical ? 4px + (1 - clamp(root.value, 0, 1)) * max(0px, parent.height - 18px) : (parent.height - 2px) / 2;
        width: root.vertical ? parent.width - 4px : 10px;
        height: root.vertical ? 10px : parent.height - 4px;
        background: root.enabled ? root.accent : #677382;
        border-radius: 1px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                if root.dragging { root.dragging = false; root.gesture-ended(); }
            } else if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.dragging = true;
                    root.requested(root.vertical ? 1 - clamp(self.mouse-y / max(1px, root.height), 0, 1) : clamp(self.mouse-x / max(1px, root.width), 0, 1));
                } else if event.kind == PointerEventKind.up {
                    if root.dragging { root.dragging = false; root.gesture-ended(); }
                }
            }
        }
        moved => {
            if root.dragging {
                root.requested(root.vertical ? 1 - clamp(self.mouse-y / max(1px, root.height), 0, 1) : clamp(self.mouse-x / max(1px, root.width), 0, 1));
            }
        }
    }
    changed enabled => {
        if !root.enabled && root.dragging { root.dragging = false; root.gesture-ended(); }
    }
}

// The mixer owns the value, including updates from the hardware controller.
export component ModernKnob inherits Rectangle {
    in property <string> label;
    in property <string> deck-name;
    in property <float> value: 0.5;
    in property <float> neutral-value: 0.5;
    in property <bool> enabled: false;
    in property <color> accent: ModernTheme.text;
    callback requested(float);
    callback gesture-ended();
    min-width: 34px; preferred-width: 44px;
    min-height: 27px; preferred-height: 50px; max-height: 56px;
    forward-focus: keys;
    accessible-role: slider;
    accessible-label: root.deck-name + " " + root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.01;
    accessible-action-set-value(v) => {
        if root.enabled && v.is-float() { root.requested(clamp(v.to-float(), 0, 1)); }
    }
    // Center detent is 0 dB even for the asymmetric EQ range (-24 to +12 dB).
    property <float> offset: clamp(root.value, 0, 1) - root.neutral-value;
    property <angle> pointer-angle: 135deg * root.offset /
        (root.offset < 0 ? root.neutral-value : 1 - root.neutral-value);
    animate pointer-angle { duration: root.dragging ? 0ms : 70ms; easing: ease-out; }
    wheel := Rectangle {
        width: min(32px, root.height - 15px); height: self.width;
        x: (parent.width - self.width) / 2; y: (root.height - self.height - 13px) / 2;
        border-radius: self.width / 2;
        background: #222932; border-width: 1px;
        border-color: keys.has-focus ? #eeeeee : ModernTheme.line;
        indicator := Rectangle {
            width: 5px; height: 5px; border-radius: 2.5px;
            x: (parent.width - self.width) / 2 + (parent.width / 2 - 4px) * sin(root.pointer-angle);
            y: (parent.height - self.height) / 2 - (parent.height / 2 - 4px) * cos(root.pointer-angle);
            background: root.enabled ? root.accent : ModernTheme.muted;
        }
    }
    Text {
        y: wheel.y + wheel.height; height: 13px; text: root.label; color: ModernTheme.muted;
        font-size: 10px; horizontal-alignment: center; vertical-alignment: center;
    }
    property <float> drag-value: 0.5;
    property <bool> dragging: false;
    function finish-drag() {
        if root.dragging { root.dragging = false; root.gesture-ended(); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel || event.kind == PointerEventKind.up {
                root.finish-drag();
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                keys.focus(); root.drag-value = root.value; root.dragging = true;
            }
        }
        moved => { if root.dragging { root.requested(clamp(root.drag-value + (self.pressed-y - self.mouse-y) / 120px, 0, 1)); } }
    }
    changed enabled => { if !root.enabled { root.finish-drag(); } }
    keys := FocusScope {
        width: 0px; height: 0px; enabled: root.enabled;
        focus-lost(reason) => { root.finish-drag(); }
        key-pressed(event) => {
            if event.text == "+" || event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.requested(clamp(root.value + 0.01, 0, 1)); return accept;
            }
            if event.text == "-" || event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.requested(clamp(root.value - 0.01, 0, 1)); return accept;
            }
            return reject;
        }
    }
}
